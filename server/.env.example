# Copiar a .env y llenar. Nunca subir .env al repositorio.
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=checador
DB_PASSWORD=cambiar
DB_NAME=checador

# JWT del panel admin (cadena larga y aleatoria)
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria

# Servicio facial (DeepFace) en la red interna
FACE_SERVICE_URL=http://127.0.0.1:8000

# Orígenes permitidos (panel y dashboard), separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Zona horaria para calcular "hoy" y tardanzas
TZ_NEGOCIO=America/Hermosillo

# Minutos para considerar un check-in duplicado
VENTANA_DUPLICADO_MIN=5
