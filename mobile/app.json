{
  "expo": {
    "name": "Checker",
    "slug": "checador-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.checador.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para firmar tu registro de asistencia."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E3F3E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.checador.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para tu foto de registro y la selfie del check-in.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
